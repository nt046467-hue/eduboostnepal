    <!-- Global Nav Auth State Controller -->
    <script>
      window.addEventListener("load", function () {
        if (typeof firebase !== "undefined" && firebase.auth) {
          firebase.auth().onAuthStateChanged(function (user) {
            var isIndex = window.location.pathname === "/" || window.location.pathname === "/index.html";
            if (user && isIndex) {
              window.location.replace("/pages/dashboard.html");
              return;
            }
            var navLogin = document.getElementById("nav-login-link");
            var navSignup = document.getElementById("nav-signup-link");
            var navDash = document.getElementById("nav-dashboard-link");
            var navLogout = document.getElementById("nav-logout-btn");
            var mobLogin = document.getElementById("mob-login-link");
            var mobSignup = document.getElementById("mob-signup-link");
            var mobDash = document.getElementById("mob-dashboard-link");
            var mobLogout = document.getElementById("mob-logout-btn");

            if (user) {
              if (navLogin) navLogin.style.display = "none";
              if (navSignup) navSignup.style.display = "none";
              if (navDash) navDash.style.display = "";
              if (navLogout) navLogout.style.display = "";
              if (mobLogin) mobLogin.style.display = "none";
              if (mobSignup) mobSignup.style.display = "none";
              if (mobDash) mobDash.style.display = "";
              if (mobLogout) mobLogout.style.display = "";
            } else {
              if (navLogin) navLogin.style.display = "";
              if (navSignup) navSignup.style.display = "";
              if (navDash) navDash.style.display = "none";
              if (navLogout) navLogout.style.display = "none";
              if (mobLogin) mobLogin.style.display = "";
              if (mobSignup) mobSignup.style.display = "";
              if (mobDash) mobDash.style.display = "none";
              if (mobLogout) mobLogout.style.display = "none";
            }
          });
        }
        window.doLogout = function () {
          if (typeof firebase !== "undefined" && firebase.auth) {
            firebase.auth().signOut().then(function () {
              window.location.reload();
            });
          }
        };
      });
    </script>

