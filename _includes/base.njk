    <!-- SHARED GLOBAL SCRIPTS -->
    <script>
      function toggleMenu() {
        var m = document.getElementById("mobile-menu"),
          h = document.getElementById("ham-icon"),
          c = document.getElementById("close-icon"),
          b = document.getElementById("hamburger");
        if (!m) return;
        var o = m.classList.toggle("open");
        if (h) h.style.display = o ? "none" : "";
        if (c) c.style.display = o ? "" : "none";
        if (b) b.setAttribute("aria-expanded", o);
        document.body.style.overflow = o ? "hidden" : "";
      }

      document.addEventListener("click", function (e) {
        var b = document.getElementById("hamburger"),
          m = document.getElementById("mobile-menu");
        if (m && m.classList.contains("open") && b && !b.contains(e.target) && !m.contains(e.target)) {
          toggleMenu();
        }
      });

      var mm = document.getElementById("mobile-menu");
      if (mm) {
        mm.addEventListener("click", function (e) {
          if (e.target.tagName === "A") {
            setTimeout(function () {
              if (mm.classList.contains("open")) toggleMenu();
            }, 50);
          }
        });
      }

      function showToast(msg, emoji) {
        var t = document.getElementById("toast");
        if (!t) return;
        t.innerHTML = "<span>" + (emoji || "ℹ️") + "</span><span>" + msg + "</span>";
        t.classList.add("show");
        setTimeout(function () {
          t.classList.remove("show");
        }, 3800);
      }

      var SHEET_URL = "/api/subscribe";
      function getDeviceType() {
        var ua = navigator.userAgent;
        if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) return "Tablet";
        if (/Mobile|Android|iP(hone|od)|IEMobile|BlackBerry|Kindle|Silk-Accelerated|(hpw|web)OS|Opera M(obi|ini)/.test(ua)) return "Mobile";
        return "Desktop";
      }
      function getBrowser() {
        var ua = navigator.userAgent;
        if (ua.indexOf("Chrome") > -1 && ua.indexOf("Edg") === -1 && ua.indexOf("OPR") === -1) return "Chrome";
        if (ua.indexOf("Safari") > -1 && ua.indexOf("Chrome") === -1) return "Safari";
        if (ua.indexOf("Firefox") > -1) return "Firefox";
        if (ua.indexOf("Edg") > -1) return "Edge";
        if (ua.indexOf("OPR") > -1 || ua.indexOf("Opera") > -1) return "Opera";
        return "Other";
      }
      function getOS() {
        var ua = navigator.userAgent;
        if (ua.indexOf("Win") > -1) return "Windows";
        if (ua.indexOf("Mac") > -1) return "MacOS";
        if (ua.indexOf("Android") > -1) return "Android";
        if (ua.indexOf("iPhone") || ua.indexOf("iPad") > -1) return "iOS";
        if (ua.indexOf("Linux") > -1) return "Linux";
        return "Other";
      }

      function handleSubscribe() {
        var n = document.getElementById("nl-name"),
          i = document.getElementById("nl-email"),
          b = document.getElementById("nl-btn");
        if (!n || !i) return;
        var name = n.value.trim(),
          e = i.value.trim(),
          r = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!name) {
          showToast("Please enter your name.", "⚠️");
          n.focus();
          return;
        }
        if (!e || !r.test(e)) {
          showToast("Enter a valid email.", "⚠️");
          i.focus();
          return;
        }
        if (b) {
          b.disabled = true;
          b.textContent = "Checking...";
        }

        function doSubscribePost() {
          if (b) b.textContent = "Subscribing...";
          fetch(SHEET_URL, {
            method: "POST",
            headers: { "Content-Type": "text/plain" },
            body: JSON.stringify({
              name: name,
              email: e,
              date: new Date().toLocaleString("en-NP", { timeZone: "Asia/Kathmandu" }),
              device: getDeviceType(),
              browser: getBrowser(),
              os: getOS(),
            }),
          })
            .then(function () {
              n.value = "";
              i.value = "";
              if (b) {
                b.textContent = "✓ Subscribed!";
                setTimeout(function () {
                  b.disabled = false;
                  b.textContent = "Subscribe";
                }, 4000);
              }
              showToast("Welcome " + name + "! You are subscribed 🎉", "📬");
            })
            .catch(function () {
              if (b) {
                b.disabled = false;
                b.textContent = "Subscribe";
              }
              showToast("Something went wrong. Try again!", "⚠️");
            });
        }

        fetch(SHEET_URL + "?email=" + encodeURIComponent(e))
          .then(function (res) { return res.text(); })
          .then(function (txt) {
            var data = {};
            try { data = JSON.parse(txt); } catch (err) {}
            if (data.status === "duplicate") {
              if (b) {
                b.disabled = false;
                b.textContent = "Subscribe";
              }
              showToast("This email is already subscribed! 😊", "✅");
              return;
            }
            doSubscribePost();
          })
          .catch(function () {
            doSubscribePost();
          });
      }

      var nlInput = document.getElementById("nl-email");
      if (nlInput) {
        nlInput.addEventListener("keydown", function (e) {
          if (e.key === "Enter") handleSubscribe();
        });
      }
    </script>

